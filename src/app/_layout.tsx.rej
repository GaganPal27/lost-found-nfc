+// Sentry must be initialized once, at module scope, before any component renders.
+// This is what catches the ClassCastException / native crashes going forward —
+// no ADB or physical cable needed, the trace uploads automatically on next launch.
+Sentry.init({
+  dsn: process.env.EXPO_PUBLIC_SENTRY_DSN,
+  enabled: !!process.env.EXPO_PUBLIC_SENTRY_DSN, // no-ops safely if DSN isn't set yet
+  debug: false,
+  tracesSampleRate: 1.0,
+  // Native crashes (Java/Kotlin ClassCastException, SIGSEGV, etc.) — not just JS errors
+  enableNative: true,
+  enableNativeCrashHandling: true,
+  attachStacktrace: true,
+  environment: __DEV__ ? 'development' : 'production',
+});
+
